   "source": [
    "def minJumps( arr):\n",
    "    i=0\n",
    "    jump=0\n",
    "    while i<len(arr)-1:\n",
    "        if arr[i]==0:\n",
    "            return jump\n",
    "        elif i+arr[i]<=len(arr)-1:\n",
    "            jump+=1\n",
    "            i+=arr[i]\n",
    "    \n",
    "    return -1"
   ]
